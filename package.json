{
  "name": "ubian-aggregator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "check:kotlin": "bash scripts/check-kotlin.sh",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:core": "cargo test --manifest-path crates/journey-core/Cargo.toml --locked",
    "doctor": "node scripts/doctor.mjs",
    "android:configure": "node scripts/configure-android.mjs",
    "android:init": "cargo tauri android init --ci && npm run android:configure",
    "android:build": "npm run android:configure && cargo tauri android build --apk --ci",
    "tauri": "cargo tauri"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
